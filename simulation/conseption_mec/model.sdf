<?xml version="1.0"?>
<sdf version="1.9">
  <model name="conseption_mec">

    <static>false</static>
    <pose>0 0 0 1.5708 0 0</pose>

    <link name="link">

      <visual name="piece1">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - Pièce1-1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="piece3_1">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - Pièce3-1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="piece3_2">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - Pièce3-2.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="piece3_3">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - Pièce3-3.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="piece3_4">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - Pièce3-4.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="etagere_1">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - etagere - Copie-1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="etagere_2">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - etagere-1.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="etagere_3">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - etagere-2.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="etagere_4">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - etagere-3.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <visual name="etagere_5">
        <geometry>
          <mesh>
            <uri>meshes/robo_cstam - etagere-4.STL</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
      </visual>

      <collision name="chassis_collision">
        <geometry><box><size>0.5 0.4 0.3</size></box></geometry>
      </collision>

      <inertial>
        <mass>5.0</mass>
        <inertia>
          <ixx>0.05</ixx><iyy>0.06</iyy><izz>0.04</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>

      <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0.25 0 0 0</pose>
        <topic>scan</topic>
        <update_rate>10</update_rate>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.12</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
        </lidar>
        <always_on>true</always_on>
        <visualize>true</visualize>
      </sensor>

    </link>

    <link name="left_wheel">
      <pose>0 0.2 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.2 0 1.5708 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.001</ixx><iyy>0.001</iyy><izz>0.001</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.08</radius><length>0.04</length></cylinder></geometry>
      </visual>
    </link>

    <joint name="left_wheel_joint" type="revolute">
      <parent>link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>1000</effort><velocity>1000</velocity></limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 0 1</xyz>
        <limit><effort>1000</effort><velocity>1000</velocity></limit>
      </axis>
    </joint>

    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.4</wheel_separation>
      <wheel_radius>0.08</wheel_radius>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>link</child_frame_id>
    </plugin>

  </model>
</sdf>
