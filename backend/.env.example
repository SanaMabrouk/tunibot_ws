# Copy to backend/.env and adjust. Every value is optional.

# rosbridge (ROS 2 in WSL is reachable on localhost from Windows)
ROSBRIDGE_HOST=localhost
ROSBRIDGE_PORT=9090

# true = no ROS needed, an in-memory robot simulates Mission Manager
FAKE_ROS=false
FAKE_STEP_SECONDS=2

# Defaults to ../src/mission_manager/config/destinations.yaml
# DESTINATIONS_FILE=

CORS_ORIGINS=http://localhost:5173,http://localhost:3000
